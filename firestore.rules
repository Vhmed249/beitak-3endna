rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // المستخدمون
    match /users/{userId} {
      // السماح بقراءة البيانات الأساسية (الاسم والصورة) لجميع المستخدمين المسجلين
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.isAdmin == false
                    && request.resource.data.isVerified == false;

      // التحديث فقط لصاحب الحساب وعدم تغيير صلاحيات المشرف والتحقق
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.isAdmin == resource.data.isAdmin
                    && request.resource.data.isVerified == resource.data.isVerified
                    && (!request.resource.data.keys().hasAny(['isBlocked']));

      allow delete: if false;

      // التحقق من الهوية
      match /verification/{verificationId} {
        allow create: if request.auth != null
                      && request.auth.uid == userId;

        allow read: if request.auth != null
                    && (request.auth.uid == userId ||
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);

        allow update, delete: if false;
      }

      // الإشعارات
      match /notifications/{notification} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // العقارات - محمية من التلاعب
    match /properties/{propertyId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.isVerified == false
                    && request.resource.data.isFeatured == false;

      allow update: if request.auth != null
                    && (
                      // المالك يمكنه التعديل فقط إذا لم يغير الحقول المحمية
                      (resource.data.userId == request.auth.uid
                       && request.resource.data.status == resource.data.status
                       && request.resource.data.isVerified == resource.data.isVerified
                       && request.resource.data.isFeatured == resource.data.isFeatured)
                      ||
                      // المشرف يمكنه تغيير كل شيء
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
                    );

      allow delete: if request.auth != null
                    && (
                      resource.data.userId == request.auth.uid ||
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
                    );
    }

    // المحادثات
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid;
      }
    }

    // التقييمات
    match /ratings/{ratingId} {
      allow read: if true;

      allow create: if request.auth != null;

      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    // البلاغات
    match /reports/{reportId} {
      allow create: if request.auth != null;

      allow read, update, delete: if false;
    }
  }
}
